#!/bin/bash
# App tier bootstrap (Amazon Linux 2023)
# Small Python API that reads DB credentials from Secrets Manager and talks to RDS.
# Everything downloaded here comes in through the NAT Gateway, which proves it works.
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

dnf update -y
dnf install -y python3 python3-pip

TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

useradd --system --no-create-home --shell /sbin/nologin appuser || true
mkdir -p /opt/app
python3 -m venv /opt/app/venv
/opt/app/venv/bin/pip install --no-cache-dir boto3 PyMySQL

cat > /opt/app/app.env <<EOF
APP_PORT=${app_port}
AWS_REGION=${aws_region}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_SECRET_ARN=${db_secret_arn}
INSTANCE_ID=$INSTANCE_ID
AZ=$AZ
EOF

cat > /opt/app/app.py <<'PYEOF'
import json
import os
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import boto3
import pymysql

PORT = int(os.environ["APP_PORT"])
INSTANCE_ID = os.environ.get("INSTANCE_ID", "unknown")
AZ = os.environ.get("AZ", "unknown")

secrets = boto3.client("secretsmanager", region_name=os.environ["AWS_REGION"])
cache = {"creds": None, "fetched_at": 0.0}


def db_credentials():
    # Cache for 5 minutes: picks up a rotated password without calling Secrets Manager per request.
    if cache["creds"] is None or time.time() - cache["fetched_at"] > 300:
        secret = secrets.get_secret_value(SecretId=os.environ["DB_SECRET_ARN"])
        cache["creds"] = json.loads(secret["SecretString"])
        cache["fetched_at"] = time.time()
    return cache["creds"]


def query_db():
    creds = db_credentials()
    conn = pymysql.connect(
        host=os.environ["DB_HOST"],
        port=int(os.environ["DB_PORT"]),
        user=creds["username"],
        password=creds["password"],
        database=os.environ["DB_NAME"],
        connect_timeout=5,
        autocommit=True,
    )
    try:
        with conn.cursor() as cur:
            cur.execute(
                "CREATE TABLE IF NOT EXISTS visits ("
                "id INT AUTO_INCREMENT PRIMARY KEY, "
                "instance_id VARCHAR(32) NOT NULL, "
                "visited_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)"
            )
            cur.execute("INSERT INTO visits (instance_id) VALUES (%s)", (INSTANCE_ID,))
            cur.execute("SELECT COUNT(*), VERSION() FROM visits")
            total, version = cur.fetchone()
        return {
            "status": "connected",
            "mysql_version": version,
            "total_visits": total,
            "written_by_app_instance": INSTANCE_ID,
        }
    finally:
        conn.close()


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            self._send(200, {"status": "ok"})
        elif self.path == "/info":
            self._send(200, {"tier": "app", "instance_id": INSTANCE_ID, "availability_zone": AZ})
        elif self.path == "/db":
            try:
                self._send(200, query_db())
            except Exception as exc:
                self._send(503, {"status": "error", "detail": str(exc)})
        else:
            self._send(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        # Skip ALB health check noise in the journal.
        if self.path != "/health":
            super().log_message(fmt, *args)


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
PYEOF

cat > /etc/systemd/system/app.service <<'EOF'
[Unit]
Description=Three-tier demo app
After=network-online.target
Wants=network-online.target

[Service]
User=appuser
EnvironmentFile=/opt/app/app.env
ExecStart=/opt/app/venv/bin/python /opt/app/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

chown -R root:root /opt/app
chmod 644 /opt/app/app.env /opt/app/app.py

systemctl daemon-reload
systemctl enable --now app
